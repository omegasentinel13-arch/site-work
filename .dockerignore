# Version control
.git
.gitignore

# Environment files and credentials (NEVER bake into image)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies (Installed cleanly inside container)
node_modules/

# Next.js build artifacts and cache
.next/
out/
build/

# SQLite databases (Persistent Volume only - NEVER bake into image)
data/
*.db
*.db-wal
*.db-shm

# Forensic backups and local archives (Local machine only)
backups/

# Tests and QA artifacts
tests/
screenshots/
scratch/
coverage/

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
