# ==============================================================================
# SITE WORK — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ==============================================================================

# Session Security (Required in production, min 32 characters)
SESSION_SECRET=site_work_secure_session_key_minimum_32_characters_long_2026

# Database Path (Optional, defaults to ./data/site_work.db)
DATABASE_PATH=./data/site_work.db

# SMTP Email Delivery for Password Recovery OTPs
# For Gmail:
#   1. Set SMTP_HOST to smtp.gmail.com
#   2. Set SMTP_PORT to 587 (or 465)
#   3. Set SMTP_USER to your Gmail address (e.g. omegasentinel13@gmail.com)
#   4. Set SMTP_PASSWORD to a Google App Password (16 characters from Google Account -> Security -> App Passwords)
#   5. Set SMTP_FROM to your display sender name and email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AB CONSTRUCTIONS & INTERIORS" <omegasentinel13@gmail.com>
